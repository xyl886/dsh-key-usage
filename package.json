{
  "name": "dsh-key-usage",
  "description": "DeepSeek Harness 侧边栏「使用情况」：按通道展示用量明细、活跃热力图、项目/会话用量与官方余额/配额（实时优先，失败回落快照）",
  "version": "0.2.5",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "usage",
    "api-key"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "client/",
    "cordis.patch.yml",
    "data/",
    "README.md",
    "docs/CHANGELOG.md",
    "LICENSE",
    "docs/images/overview.png",
    "docs/images/daily.png",
    "docs/images/projects.png",
    "docs/images/models.png",
    "docs/images/sessions.png",
    "docs/images/session-detail.png",
    "docs/images/quota.png"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyl886/dsh-key-usage.git"
  },
  "homepage": "https://github.com/xyl886/dsh-key-usage",
  "bugs": {
    "url": "https://github.com/xyl886/dsh-key-usage/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsdown && node scripts/normalize-client-banner.mjs",
    "build:client": "tsdown && node scripts/normalize-client-banner.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node scripts/check-lib.mjs",
    "test": "node scripts/test-all.mjs",
    "verify": "npm run typecheck && npm run build && npm run check && npm run check:tokens && npm run check:ui && npm run check:css && npm run check:eol && npm run check:i18n && npm run test",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:ui": "node scripts/check-ui-scale.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "pack:dry": "npm pack --dry-run",
    "check:css": "node scripts/check-css-modules.mjs",
    "check:eol": "node scripts/check-eol.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "lightningcss": "1.33.0",
    "react": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "jieba-wasm": "^2.4.0",
    "node-sqlite3-wasm": "^0.8.61"
  }
}
